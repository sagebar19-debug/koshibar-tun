ing:12px;background:var(--bg);color:var(--text);margin-top:5px}textarea{min-height:95px;resize:vertical}.btn{background:var(--text);color:var(--bg);border:1px solid var(--line);border-radius:10px;padding:11px 14px;margin:12px 7px 0 0;font-weight:bold}.btn.ghost{background:none;color:var(--text)}.btn.greenbtn{background:#0a9d68;color:#fff;border-color:#0a9d68}.check{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line)}input[type=checkbox]{width:21px;height:21px;accent-color:#777}.code{overflow-wrap:anywhere;border:1px dashed var(--line);padding:12px;border-radius:10px}a{color:inherit}p{line-height:1.55}.small{font-size:12px;color:var(--muted)}.log{font-size:12px;padding:10px 0;border-bottom:1px solid var(--line)}
</style></head><body><header><div class="logo">KOSHIBAR TUN</div><div class="sub">NINJA SECURE TUNNEL</div></header><main>
<section class="page active" id="home"><div class="triplet"><div class="tile"><small>ÉTAT VPN</small><b id="state" class="red">● Déconnecté</b></div><div class="tile"><small>RÉSEAU</small><b id="network">Vérification</b></div><div class="tile"><small>SERVEUR</small><b id="server">Aucun</b></div></div><div class="msg"><span id="message">Bienvenue sur KOSHIBAR TUN</span></div><button id="ninja" class="ninja-button" aria-label="Ninja : état du VPN" onclick="toggleVPN()"><img id="ninjaImage" alt="Ninja debout : VPN déconnecté"></button><p class="hint" id="hint">Touchez le ninja pour vous connecter • Moteur Android à intégrer</p><div class="stats"><div class="tile"><small>⬆ ENVOYÉ</small><b id="up">-- MB</b></div><div class="tile"><small>⬇ REÇU</small><b id="down">-- MB</b></div><div class="tile"><small>◉ PING</small><b id="ping">-- ms</b></div></div></section>
