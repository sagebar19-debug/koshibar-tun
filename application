:root{--bg:#050505;--card:#111;--text:#fff;--muted:#aaa;--line:#333;--accent:#fff;--glass:rgba(255,255,255,.055)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,Arial,sans-serif;min-height:100vh}body.light{--bg:#f8fcff;--card:#fff;--text:#111;--muted:#555;--line:#ccc;--glass:rgba(0,0,0,.04)}body.cloud{--bg:#effaff;--card:#fff;--text:#10212c;--muted:#536777;--line:#bddae7;--glass:rgba(255,255,255,.65);background:linear-gradient(#b5eaff,#fff 65%) fixed}body.photo{background:linear-gradient(#0007,#0007),var(--wall) center/cover fixed;color:white;--card:#141414cc;--text:#fff;--muted:#ddd;--line:#888}button,input,textarea,select{font:inherit}button{cursor:pointer}header{text-align:center;padding:21px 12px 7px}.logo{font-size:26px;letter-spacing:3px;font-weight:900;text-shadow:0 0 12px var(--text);animation:glow 3s infinite alternate}.logo:before{content:'◈';display:block;font-size:34px;margin-bottom:3px}@keyframes glow{from{filter:brightness(.7)}to{filter:brightness(1.5)}}.sub{font-size:10px;letter-spacing:3px;color:var(--muted)}main{max-width:600px;margin:auto;padding:12px 13px 95px}.page{display:none}.page.active{display:block}.triplet{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px}.tile,.card{border:1px solid var(--line);background:var(--glass);border-radius:16px;padding:12px}.tile{text-align:center;min-width:0}.tile small{display:block;font-size:10px;color:var(--muted);margin-bottom:7px}.tile b{font-size:12px;overflow-wrap:anywhere}.red{color:#ff5463}.green{color:#25e6a3}.msg{min-height:33px;margin:16px auto 0;text-align:center;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden}.msg span{display:inline-block;animation:marquee 13s linear infinite}@keyframes marquee{0%{transform:translateX(110%)}100%{transform:translateX(-110%)}}.ninja-button{width:100%;height:min(47vh,420px);min-height:265px;border:0;background:none;display:grid;place-items:center;padding:0;position:relative;outline-offset:-5